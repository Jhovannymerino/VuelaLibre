# Copy to .env (already gitignored) and fill in real values. Never commit real credentials.
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
# "production" for live commercial data; anything else (or unset) uses the
# Amadeus test environment, which returns cached/sample data.
AMADEUS_ENV=test
# Port the backend (server/index.js) listens on.
PORT=8787
# Only needed if PORT is changed: tells vite.config.js where to proxy /api requests.
BACKEND_PORT=8787
